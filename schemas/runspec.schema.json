{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caep.dev/schema/v0.2/runspec.json",
  "title": "CAEP RunSpec v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_version",
    "run_id",
    "source",
    "task",
    "agent",
    "model",
    "harness"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.2-draft"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "native_trial_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "task_id"
      ],
      "properties": {
        "benchmark": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": "string"
        },
        "repository_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}